    "## 2 Число сообщений юзеру с конкретным топиком\n",
    "for top in cleanmc.topic.unique():\n",
    "    col_name = str(top).replace(' ', '') + '_mes_num'\n",
    "    cleanmc.loc[cleanmc.topic==top, col_name] = cleanmc.loc[cleanmc.topic==top, ['id_mes', 'client_id']].groupby(by='client_id').transform('count')['id_mes']\n",
    "\n",
    "cleanmc.iloc[:, 33:]"
   ]
  },
